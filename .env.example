# ============================================================
# ZARUBA — что куда писать
# Скопируй в .env или в переменные Bothost. Пустое = не используется.
# 1 = включено, 0 = выключено
# Bothost Node.js: главный файл index.js
# ============================================================

# --- Выключатели ---
# Панель в Discord (баннер, сервера, кнопка Играть, команда /панель)
ENABLE_PANEL=1
# Ник/статус ботов-мониторов: «СЕРВЕР 1» + «12/100 · карта»
ENABLE_MONITORS=1

# --- Сообщество ---
COMMUNITY_NAME=ZARUBA
# Steam App ID игры Wardogs
GAME_APP_ID=1867240
# Баннер панели
PANEL_BANNER_URL=https://i.ibb.co/1Ypjc3nv/12121212.jpg

# --- Основной бот панели ---
# Токен бота, который постит панель. Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=
# Application ID того же бота (General Information → Application ID)
DISCORD_CLIENT_ID=
# ID Discord-сервера (ПКМ по серверу → Копировать ID, нужен режим разработчика)
DISCORD_GUILD_ID=
# Канал, куда сам кинет панель при старте. Можно пусто — тогда только /панель
DISCORD_CHANNEL_ID=

# --- Join-сайт (кнопка Играть открывает https://.../join?server=1) ---
# Bothost сам даст DOMAIN, если включить вкладку Домен
PORT=3000
PUBLIC_URL=
DOMAIN=
# На Bothost оставь как есть
DATA_DIR=

# --- Steam (чтобы кнопка кидала в лобби) ---
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- Сервер 1 ---
# Как пишется в панели
SERVER_1_NAME=СЕРВЕР 1
# Точное имя сервера в игре, как в браузере Wardogs
SERVER_1_QUERY=
# Внутренний game id, если знаешь
SERVER_1_GAME_ID=
# HTTP RCON: хост без http://
SERVER_1_RCON_HOST=
SERVER_1_RCON_PORT=
SERVER_1_RCON_PASSWORD=
# Отдельный бот только под статус этого сервера. Пусто = монитора нет
SERVER_1_BOT_TOKEN=
# 1 = в панели «Скоро», RCON не обязателен
SERVER_1_SOON=0

# --- Сервер 2 ---
SERVER_2_NAME=СЕРВЕР 2
SERVER_2_QUERY=
SERVER_2_GAME_ID=
SERVER_2_RCON_HOST=
SERVER_2_RCON_PORT=
SERVER_2_RCON_PASSWORD=
SERVER_2_BOT_TOKEN=
SERVER_2_SOON=0

# --- Сервер 3 (не заполнил — не покажется) ---
SERVER_3_NAME=СЕРВЕР 3
SERVER_3_QUERY=
SERVER_3_GAME_ID=
SERVER_3_RCON_HOST=
SERVER_3_RCON_PORT=
SERVER_3_RCON_PASSWORD=
SERVER_3_BOT_TOKEN=
SERVER_3_SOON=0

# --- Сервер 4 ---
SERVER_4_NAME=СЕРВЕР 4
SERVER_4_QUERY=
SERVER_4_GAME_ID=
SERVER_4_RCON_HOST=
SERVER_4_RCON_PORT=
SERVER_4_RCON_PASSWORD=
SERVER_4_BOT_TOKEN=
SERVER_4_SOON=0

# --- Темп опроса ---
POLL_INTERVAL_MS=15000
MONITOR_INTERVAL_MS=30000
STALE_AFTER_MS=45000
